# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Railway injects this automatically when you attach a Postgres plugin.
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/documind

# ── Redis ─────────────────────────────────────────────────────────────────────
# Railway injects this automatically when you attach a Redis plugin.
# Format: redis://:password@host:port
REDIS_URL=redis://localhost:6379

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Maximum number of requests allowed per IP within the rolling window.
RATE_LIMIT_REQUESTS=60
# Length of the rolling window in seconds.
RATE_LIMIT_WINDOW_SECONDS=60

# ── Task queue ────────────────────────────────────────────────────────────────
# Seconds the uploaded file bytes are kept in Redis while waiting for the worker.
JOB_FILE_TTL_SECONDS=60
# Seconds the finished result is kept in Redis for the client to poll.
JOB_RESULT_TTL_SECONDS=300
# How long POST /predict waits inline for the result before falling back to async polling.
INLINE_WAIT_SECONDS=12.0
